# ---------------------------------------------------------------------------
# Boost.Build recipe for the bundled HDF5.
#
# Rewritten for HDF5 1.14.6. What changed vs the old 1.8.7 autotools-clone recipe:
#   * H5detect.c and H5make_libsettings.c were REMOVED upstream (>=1.10), so the
#     old "compile+run H5detect -> generate H5Tinit.c" and "compile+run
#     H5make_libsettings -> generate H5lib_settings.c" steps are gone. In 1.14
#     native type init comes from the SHIPPED H5Tinit_float.c, and the library
#     settings string from a CMake-generated H5build_settings.c committed into the
#     tarball at src/H5build_settings.c. Both are picked up by the src/*.c glob.
#   * H5pubconf.h is now generated by CMake (config/cmake/H5pubconf.h.in). We ship a
#     committed, CMake-generated H5pubconf.h under src/<os>/ (see H5pubconf aliases):
#     src/windows/H5pubconf.h (MSVC) and src/posix/H5pubconf.h (gcc/Linux), both
#     threadsafe, zlib-deflate-enabled, no szip. src/darwin/H5pubconf.h is intentionally
#     not shipped -- upstream no longer builds the macOS/darwin target (see the README
#     build matrix), so the darwin H5pubconf alias is dropped rather than left dangling.
#   * Thread-safety is ON (H5_HAVE_THREADSAFE 1) -- mz5 drives HDF5 from worker
#     threads and requires it (a non-threadsafe build fails Serializer_mz5_Test
#     with "not a property list"). The old Windows H5TS_win32_first_thread_init
#     "init_once_workaround" is nonetheless DROPPED: HDF5 1.14's rewritten H5TS
#     does its own InitOnce process init in a static lib, so the external
#     workaround is obsolete (it no longer exists in the 1.14 source).
#   * Backward file-format compat (old HDF5 1.8 can read files pwiz writes) is the
#     mz5 writer's responsibility via H5Pset_libver_bounds(..., H5F_LIBVER_V18);
#     see pwiz/data/msdata/mz5 (per upstream issue #4083).
# ---------------------------------------------------------------------------


import extension ;

import property ;
import project ;
import feature ;
import common ;
import tar ;
import path ;

extension.declare hdf5 ;

.posix_usage_defines = _LARGEFILE_SOURCE _LARGEFILE64_SOURCE _BSD_SOURCE ;
.posix_build_defines = $(.posix_usage_defines) NDEBUG ;

rule init ( version ? : location : options * )
{
    if ! $(.initialized)
    {
        .initialized = true ;

        path-constant HDF5_SRC : $(location) ;

        # src/H5FDsubfiling holds H5FDsubfiling.h / H5FDioc.h, which the master hdf5.h
        # #includes unconditionally (the subfiling VFD itself needs MPI and is NOT built,
        # but the public headers must still be on the include path for every consumer).
        .usage-requirements = <include>$(location)/src <include>$(location)/src/H5FDsubfiling <use>H5pubconf.h/<extension>hdf5 ;
        .requirements = $(.usage-requirements) <warnings>off [ extension.static-with-fpic ] ;

        if [ path.exists $(location).tar.bz2 ]
        {
            tar.extract $(location).tar.bz2 : *.c *.h : : : <check-last-file-only>true ;
        }
        else if ! [ path.exists $(location) ]
        {
            import errors ;
            errors.user-error "HDF5 source tree not found at $(location)" ;
        }

        local zlib-src-location = [ feature.get-values <zlib-src-location> : $(options) ] ;
        zlib-src-location ?= $(location)/../zlib-1.3.1 ;
        path-constant ZLIB_SOURCE : $(zlib-src-location[1]) ;
        using ext-zlib : 1.3.1 : $(ZLIB_SOURCE) ;

        local boost-src-location = [ feature.get-values <boost-src-location> : $(options) ] ;
        boost-src-location ?= $(location)/../boost_1_86_0 ;
        path-constant BOOST_SOURCE : $(boost-src-location[1]) ;
        using ext-boost : 1.86.0 : $(BOOST_SOURCE) ;

        # HDF5 1.14 ships H5pubconf.h as a CMake template only; we ship a committed
        # CMake-generated copy per platform under src/<os>/ (windows + posix populated;
        # darwin dropped -- macOS is no longer an upstream build target).
        alias H5pubconf.h : $(location)/src/posix/H5pubconf.h : <location>$(location) <conditional>@H5pubconf-requirements : : <conditional>@H5pubconf-requirements ;
        alias H5pubconf.h : $(location)/src/windows/H5pubconf.h : <location>$(location) <conditional>@H5pubconf-requirements <toolset>msvc : : <conditional>@H5pubconf-requirements ;

        # Exclude parallel (MPI) and szip sources; both are #ifdef-guarded upstream and
        # unused in our config (no MPI, no szip). Everything else -- including the shipped
        # H5Tinit_float.c and the committed generated H5build_settings.c -- comes from src/.
        local .excluded-src = *mpi*.c *szip.c ;

        lib hdf5
            : # sources
                [ path.glob $(location)/src : *.c : $(.excluded-src) ]
            : # requirements
                $(.requirements)
                <conditional>@hdf5-requirements
            : # default-build
            : # usage-requirements
                $(.usage-requirements)
                <conditional>@hdf5-usage-requirements
            ;

        lib hdf5pp
            : # sources
                [ path.glob $(location)/c++/src : *.cpp ]
            : # requirements
                $(.requirements)
                <include>$(location)/c++/src
                <library>hdf5
            : # default-build
            : # usage-requirements
                $(.usage-requirements)
                <include>$(location)/c++/src
                <library>hdf5
            ;
    }
}

rule H5pubconf-requirements ( properties * )
{
    if <target-os>windows in $(properties)
    {
        return <include>$(HDF5_SRC)/src/windows ;
    }
    else if <toolset>darwin in $(properties)
    {
        return <include>$(HDF5_SRC)/src/darwin ;
    }
    else
    {
        return <include>$(HDF5_SRC)/src/posix ;
    }
}

rule link-requirements ( properties * )
{
    # HACK: <link>shared isn't being passed in properties like I'd expect, so I also check the command-line
    if <link>shared in $(properties) || "link=shared" in [ modules.peek : ARGV ]
    {
        return <library>/ext/boost//thread/<link>shared
               <library>/ext/zlib//z/<link>shared ;
    }
    else
    {
        return <library>/ext/boost//thread
               <library>/ext/zlib//z ;
    }
}

rule hdf5-requirements ( properties * )
{
    if <target-os>windows in $(properties)
    {
        # HDF5 1.14 H5system.c uses StrStrIA (Wstrcasestr_wrap) -> needs Shlwapi.
        return <conditional>@link-requirements <find-shared-library>Shlwapi ;
    }
    else if <toolset>darwin in $(properties)
    {
        return <define>$(.posix_build_defines)
               <conditional>@link-requirements ;
    }
    else
    {
        local result = <define>$(.posix_build_defines)
                       <define>_POSIX_SOURCE
                       <conditional>@link-requirements ;
        if <toolset>gcc in $(properties)
        {
            result += <cflags>-std=c99 ;
        }
        return $(result) ;
    }
}

rule hdf5-usage-requirements ( properties * )
{
    if <target-os>windows in $(properties)
    {
        # propagate Shlwapi to consumers so final EXEs resolve StrStrIA from libhdf5
        return <conditional>@link-requirements <find-shared-library>Shlwapi ;
    }
    else
    {
        return <define>$(.posix_usage_defines) ;
    }
}
